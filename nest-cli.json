{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "defaultLibraryNamespace": "@app",
  "sourceRoot": "apps/telegram-bot/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/telegram-bot/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/telegram-bot",
  "projects": {
    "binance-worker": {
      "type": "application",
      "root": "apps/binance-worker",
      "entryFile": "main",
      "sourceRoot": "apps/binance-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/binance-worker/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "telegram-bot": {
      "type": "application",
      "root": "apps/telegram-bot",
      "entryFile": "main",
      "sourceRoot": "apps/telegram-bot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telegram-bot/tsconfig.app.json"
      }
    }
  }
}